{
  "name": "geneloop-desktop",
  "version": "0.3.0-preview.20",
  "private": true,
  "description": "GeneLoop Desktop：本地界面与桌面宿主，连接 GeneLoop 执行服务",
  "author": "GeneLoop contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc && node scripts/build-motif-evidence.mjs && node scripts/prepare-assets.mjs",
    "dev": "npm run build && electron .",
    "check": "tsc --noEmit && node --test ../../tests/test_desktop_shell.mjs ../../tests/test_desktop_frontend.mjs",
    "smoke": "npm run build && node scripts/check-local-ui.mjs",
    "smoke:packaged": "node scripts/check-package.mjs",
    "smoke:account": "npm run build && node scripts/check-account-login.mjs",
    "smoke:renderer": "npm run build && node scripts/check-renderer.mjs",
    "check:installer": "node scripts/check-installer-processes.mjs",
    "check:installer-payload": "node scripts/check-installer-payload.mjs",
    "check:installer-transaction": "node scripts/check-installer-transaction.mjs",
    "check:tool-parity": "node scripts/audit-web-tool-parity.mjs --check",
    "smoke:common": "node scripts/check-native-common.mjs",
    "pack": "npm run build && npm run runtime:stage && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "dist": "npm run build && npm run runtime:stage && node scripts/build-installer.mjs",
    "check:motif": "node scripts/build-motif-evidence.mjs && node --test ../../tests/test_desktop_motif_library.mjs",
    "smoke:local-workspace": "npm run build && npm run runtime:stage && node scripts/check-local-workspace.mjs",
    "runtime:stage": "node scripts/stage-local-runtime.mjs",
    "tools:stage": "node scripts/stage-desktop-tools.mjs",
    "tools:office": "node scripts/stage-office-kit.mjs",
    "tools:complete": "node scripts/prepare-complete-tools.mjs",
    "tools:packs": "node scripts/build-tool-packs.mjs",
    "smoke:native": "node scripts/check-native-platform.mjs",
    "smoke:remotion": "node scripts/check-native-remotion.mjs",
    "smoke:ppt": "node scripts/check-native-ppt.mjs",
    "smoke:ppt-scope": "node scripts/check-ppt-authoring-scope.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "csv-parse": "7.0.3",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.539"
  },
  "dependencies": {},
  "build": {
    "appId": "ai.geneloop.desktop",
    "productName": "GeneLoop Desktop",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "!assets/installer*.bmp",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-tools-bundle",
        "to": "geneloop-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null,
    "afterPack": "./scripts/pack-runtime.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "GeneLoop-Desktop-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "format": "UDZO",
      "backgroundColor": "#f7f7fa",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 130,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "installerHeader": "assets/installerHeader.bmp",
      "installerSidebar": "assets/installerSidebar.bmp",
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "GeneLoop-Desktop-${version}-${arch}-Engine.${ext}"
    }
  }
}
