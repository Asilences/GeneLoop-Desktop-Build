{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "purpose", "text", "structured", "protected_prose"],
  "properties": {
    "format": {"const": "geneloop.privacy-policy/v1"},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["score_threshold", "declared_categories", "conditional_categories", "conditional_context_implemented", "excluded_generic_entities", "requested_entities_by_language", "supplemental_patterns", "entity_category_map"],
      "properties": {
        "score_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "declared_categories": {"$ref": "#/$defs/names"},
        "conditional_categories": {"$ref": "#/$defs/names"},
        "conditional_context_implemented": {"type": "boolean"},
        "excluded_generic_entities": {"$ref": "#/$defs/names"},
        "requested_entities_by_language": {
          "type": "object", "additionalProperties": false, "required": ["en", "zh"],
          "properties": {"en": {"$ref": "#/$defs/names"}, "zh": {"$ref": "#/$defs/names"}}
        },
        "supplemental_patterns": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "entity_category_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/name"}},
        "canonicalize_labels": {"type": "boolean"},
        "contextual_recognizers": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "upstream", "entity", "base_score", "context_by_language"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "upstream": {"enum": ["CreditCardRecognizer", "UsPassportRecognizer", "IbanRecognizer"]},
              "entity": {"$ref": "#/$defs/name"},
              "base_score": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.4},
              "explicit_labels_by_language": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "en": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "zh": {"type": "array", "items": {"type": "string", "minLength": 1}}
                }
              },
              "context_by_language": {
                "type": "object", "additionalProperties": false, "required": ["en", "zh"],
                "properties": {
                  "en": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "zh": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      }
    },
    "structured": {
      "type": "object", "additionalProperties": false, "required": ["secret_fields", "identity_fields"],
      "properties": {
        "secret_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "identity_fields": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/name"}}
      }
    },
    "protected_prose": {
      "type": "object", "additionalProperties": false, "required": ["protocol_words"],
      "properties": {"protocol_words": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
  }
}
