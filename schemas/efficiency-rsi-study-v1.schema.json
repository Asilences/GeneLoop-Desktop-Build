{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geneloop.local/schemas/efficiency-rsi-study-v1.schema.json",
  "title": "效率与能力可达性研究数据；不是执行或发布授权",
  "oneOf": [
    {
      "$ref": "#/$defs/study"
    },
    {
      "$ref": "#/$defs/registry"
    },
    {
      "$ref": "#/$defs/observations"
    }
  ],
  "$defs": {
    "study": {
      "type": "object",
      "properties": {
        "format": {
          "const": "efficiency_rsi_study_v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "objective": {
          "enum": [
            "cost_efficiency",
            "capability_accessibility",
            "efficiency_and_capability"
          ]
        },
        "conditions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "id",
            "sha256",
            "ref"
          ],
          "additionalProperties": false
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "split": {
                "enum": [
                  "training",
                  "validation",
                  "final_test"
                ]
              }
            },
            "required": [
              "id",
              "sha256",
              "family",
              "split"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "arms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "execution_snapshot_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "build_snapshot_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "execution_capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^cap_[a-f0-9]{24}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "build_capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^cap_[a-f0-9]{24}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "execution_snapshot_sha256",
              "build_snapshot_sha256",
              "execution_capabilities",
              "build_capabilities"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "baseline_arm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "arm_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "replicate": {
                "type": "integer",
                "minimum": 0
              },
              "phase": {
                "enum": [
                  "execution",
                  "construction"
                ]
              },
              "budget_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "task_id",
              "arm_id",
              "replicate",
              "phase",
              "budget_usd",
              "max_attempts"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "allocation_policy": {
          "const": "explicit_conserved_weights_v1"
        },
        "budget_policy": {
          "const": "research_comparison_not_platform_authorization"
        },
        "overhead_allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "seed_learning",
                  "generation",
                  "repair",
                  "certification",
                  "validation",
                  "maintenance",
                  "recovery",
                  "research_evaluation"
                ]
              },
              "weights": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minProperties": 1
              }
            },
            "required": [
              "category",
              "weights"
            ],
            "additionalProperties": false
          }
        },
        "budget_scope": {
          "const": "attempt_execution"
        }
      },
      "required": [
        "format",
        "id",
        "objective",
        "conditions_sha256",
        "rubric_sha256",
        "evaluator",
        "required_checks",
        "tasks",
        "arms",
        "baseline_arm",
        "cells",
        "allocation_policy",
        "budget_policy",
        "overhead_allocations",
        "budget_scope"
      ],
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "properties": {
        "format": {
          "const": "efficiency_rsi_registry_v1"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cell_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "attempt_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true
              },
              "closed": {
                "type": "boolean"
              }
            },
            "required": [
              "cell_id",
              "attempt_ids",
              "closed"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "request_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ledger_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "ledger_ref",
              "id"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "overhead_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        }
      },
      "required": [
        "format",
        "plan_sha256",
        "cells",
        "request_refs",
        "overhead_ids"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "properties": {
        "format": {
          "const": "efficiency_rsi_observations_v1"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "cell_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "parent_attempt_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conditions_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "execution_snapshot_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "build_snapshot_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "execution_capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^cap_[a-f0-9]{24}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "build_capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^cap_[a-f0-9]{24}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "status": {
                "enum": [
                  "completed",
                  "quality_failed",
                  "budget_exhausted",
                  "provider_error",
                  "environment_error",
                  "cancelled",
                  "running"
                ]
              },
              "request_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ledger_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "ledger_ref",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "artifact_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "artifact_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "quality": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "wall_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "id",
              "cell_id",
              "ordinal",
              "parent_attempt_id",
              "conditions_sha256",
              "execution_snapshot_sha256",
              "build_snapshot_sha256",
              "execution_capabilities",
              "build_capabilities",
              "status",
              "request_refs",
              "artifact_ref",
              "artifact_sha256",
              "quality",
              "wall_seconds"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "overheads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "category": {
                "enum": [
                  "seed_learning",
                  "generation",
                  "repair",
                  "certification",
                  "validation",
                  "maintenance",
                  "recovery",
                  "research_evaluation"
                ]
              },
              "request_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ledger_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "ledger_ref",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "category",
              "request_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ledger_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "phase": {
                "enum": [
                  "booked",
                  "completed",
                  "failed"
                ]
              },
              "observed_peak_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "reserved_upper_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "allocations": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minProperties": 1
              }
            },
            "required": [
              "ledger_ref",
              "id",
              "phase",
              "observed_peak_usd",
              "reserved_upper_usd",
              "allocations"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "format",
        "plan_sha256",
        "registry_sha256",
        "attempts",
        "overheads",
        "providers"
      ],
      "additionalProperties": false
    }
  }
}
